rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function profile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    function activeUser() {
      return signedIn() && profile().status == "active";
    }
    function admin() {
      return activeUser() && profile().role == "Administrator";
    }
    function librarian() {
      return activeUser() && (profile().role == "Librarian" || profile().role == "Administrator");
    }

    match /users/{uid} {
      allow read: if librarian();
      allow create: if signedIn() && request.auth.uid == uid;
      allow update: if admin() || (signedIn() && request.auth.uid == uid);
      allow delete: if admin();
    }

    match /members/{id} {
      allow read, create, update: if librarian();
      allow delete: if admin();
    }

    match /books/{id} {
      allow read, create, update: if librarian();
      allow delete: if admin();
    }

    match /loans/{id} {
      allow read, create, update: if librarian();
      allow delete: if admin();
    }

    match /fines/{id} {
      allow read, create, update: if librarian();
      allow delete: if admin();
    }

    match /settings/{id} {
      allow read: if librarian();
      allow create, update, delete: if admin();
    }

    match /counters/{id} {
      allow read, create, update: if librarian();
      allow delete: if admin();
    }
  }
}